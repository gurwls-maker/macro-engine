{
  "name": "macro-engine",
  "version": "9.0.0-rc.1",
  "private": true,
  "description": "Personal nutrition planning and a local-first food and training diary.",
  "scripts": {
    "start": "node tools/serve.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "node tests/browser.cjs && node tests/storage-browser.cjs",
    "test:all": "npm test && npm run test:e2e",
    "preflight:product": "node tools/preflight.cjs",
    "setup:browsers": "playwright install chromium",
    "vendor:icons": "node tools/vendor-icons.cjs"
  },
  "devDependencies": {
    "lucide": "1.52.0",
    "playwright": "1.61.1"
  }
}
